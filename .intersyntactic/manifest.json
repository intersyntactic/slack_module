{
  "name": "intersyntactic_slack",
  "version": "0.2.0",
  "acceptors": {
    "slack_mirror": {
      "version": "1",
      "shape": "a Slack-anchored node: message, edit, reaction, tombstone, or slack_event_raw (loosely typed with a slack_event_type discriminator)",
      "use": "mirror a Slack-anchored journey path; every node bound here is appended to the journey path in the head's order, so the mirror never drifts from what Slack sent",
      "from": ["modules"]
    }
  },
  "offerings": {
    "message": {
      "shape": "SlackMessage",
      "shape_file": "lib/src/shapes.dart",
      "binds": ["slack_mirror"]
    },
    "edit": {
      "shape": "SlackEdit",
      "shape_file": "lib/src/shapes.dart",
      "binds": ["slack_mirror"]
    },
    "reaction": {
      "shape": "SlackReaction",
      "shape_file": "lib/src/shapes.dart",
      "binds": ["slack_mirror"]
    },
    "tombstone": {
      "shape": "SlackTombstone",
      "shape_file": "lib/src/shapes.dart",
      "binds": ["slack_mirror"]
    },
    "slack_event_raw": {
      "shape": "SlackEventRaw",
      "shape_file": "lib/src/shapes.dart",
      "binds": ["slack_mirror"]
    },
    "chat_post": {
      "tool": "chat_post",
      "effect": "POST https://slack.com/api/chat.postMessage",
      "binds": ["tools"],
      "placement": "home"
    },
    "chat_update": {
      "tool": "chat_update",
      "effect": "POST https://slack.com/api/chat.update",
      "binds": ["tools"],
      "placement": "home"
    },
    "chat_delete": {
      "tool": "chat_delete",
      "effect": "POST https://slack.com/api/chat.delete",
      "binds": ["tools"],
      "placement": "home"
    },
    "reactions_add": {
      "tool": "reactions_add",
      "effect": "POST https://slack.com/api/reactions.add",
      "binds": ["tools"],
      "placement": "home"
    }
  }
}
