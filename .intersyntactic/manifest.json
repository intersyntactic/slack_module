{
  "name": "intersyntactic_slack",
  "version": "0.2.0",
  "acceptors": {
    "slack_mirror": {
      "version": "1",
      "shape": "a Slack-anchored node: message, edit, reaction, tombstone, or slack_event_raw (loosely typed with a slack_event_type discriminator)",
      "use": "mirror a Slack-anchored line; every node bound here is appended to the line in the head's order, so the mirror never drifts from what Slack sent",
      "from": ["modules"]
    }
  },
  "offerings": {
    "message": {
      "shape": "message",
      "binds": ["slack_mirror"]
    },
    "edit": {
      "shape": "edit",
      "binds": ["slack_mirror"]
    },
    "reaction": {
      "shape": "reaction",
      "binds": ["slack_mirror"]
    },
    "tombstone": {
      "shape": "tombstone",
      "binds": ["slack_mirror"]
    },
    "slack_event_raw": {
      "shape": "slack_event_raw",
      "binds": ["slack_mirror"]
    },
    "chat_post": {
      "tool": "chat_post",
      "effect": "POST https://slack.com/api/chat.postMessage",
      "binds": ["tools"]
    },
    "chat_update": {
      "tool": "chat_update",
      "effect": "POST https://slack.com/api/chat.update",
      "binds": ["tools"]
    },
    "chat_delete": {
      "tool": "chat_delete",
      "effect": "POST https://slack.com/api/chat.delete",
      "binds": ["tools"]
    },
    "reactions_add": {
      "tool": "reactions_add",
      "effect": "POST https://slack.com/api/reactions.add",
      "binds": ["tools"]
    }
  }
}
